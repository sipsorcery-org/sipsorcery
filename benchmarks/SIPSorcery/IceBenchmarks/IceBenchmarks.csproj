<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LibVersion)' != ''">
    <DefineConstants>$(DefineConstants);LibVersion;LibVersion_$(LibVersion.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SIPSorcery\SIPSorcery.csproj" Condition="'$(LibVersion)' == ''" />
    <PackageReference Include="SIPSorcery" Version="$(LibVersion)" Condition="'$(LibVersion)' != ''" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
  </ItemGroup>

</Project>
