{
  // The settings below are the committed defaults. To override them with your own values
  // create an appsettings.local.json file beside this one with the same structure. That file
  // is git ignored, is optional and only needs to contain the keys you want to change.
  "Softphone": {
    "SIPUsername": "7000",
    "SIPPassword": "password",
    "SIPServer": "192.168.11.24",
    "SIPFromName": "Softphone Sample",
    "STUNServerHostname": "",
    // The source for the video stream. If set to None a video stream will not be offered.
    // Options are: None, Webcam, AudioScope and TestPattern.
    "VideoSource": "Webcam",
    "AudioOutDeviceIndex": -1,
    // If set to true the SIP clients will use a WebRTC compatible RTP session when making and accepting
    // calls. This will only work with SIP clients that support it such as browser based SIP clients such as
    // sip.js and JsSIP. When set to false a normal VoIP RTP session is used.
    "UseWebRTCMedia": false,
    // Optional. If left empty a single UDP channel on the default SIP port is used.
    // Protocol can be udp, tcp or tls. A tls channel also needs a CertificatePath.
    // "SIPSockets": [
    //   { "Endpoint": "192.168.11.50:7060", "Protocol": "udp" }
    // ],
    "SIPSockets": []
  }
}
