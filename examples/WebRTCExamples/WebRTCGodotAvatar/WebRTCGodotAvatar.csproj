<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- Override any repo-wide LangVersion: the Godot source generators emit C# 9+ syntax. -->
    <LangVersion>latest</LangVersion>
    <!-- The gd_cubism addon's C# helper scripts (addons/gd_cubism/cs) use unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The gd_cubism addon bundles example scripts that target an older API version and don't
         compile; the Live2D model uses the native GDCubismUserModel via ClassDB, not these. -->
    <Compile Remove="addons/gd_cubism/example/**/*.cs" />
    <!-- build-gd-cubism.ps1 clones the gd_cubism source into ThirdParty/ to build the native
         library. That tree bundles its own copy of the addon's C# scripts, which would collide
         with addons/gd_cubism/cs (CS0102/CS0111). It is build scratch, not project source. -->
    <Compile Remove="ThirdParty/**/*.cs" />
    <!-- The 2dog executable is a separate .NET host project. Its Program.cs must not be
         compiled into the Godot project assembly referenced by that host. -->
    <Compile Remove="WebRTCGodotAvatar.2dog/**/*.cs" />
    <!-- Reuse the Max demo's in-process renderer implementations. They implement the same
         IAvatarRenderer contract and emit encoded video directly to the WebRTC track. -->
    <Compile Include="..\WebRTCMaxHeadroom\IAvatarRenderer.cs" Link="Renderers\IAvatarRenderer.cs" />
    <Compile Include="..\WebRTCMaxHeadroom\MaxHeadroomVideoSource.cs" Link="Renderers\MaxHeadroomVideoSource.cs" />
    <Compile Include="..\WebRTCMaxHeadroom\MelSpectrogram.cs" Link="Renderers\MelSpectrogram.cs" />
    <Compile Include="..\WebRTCMaxHeadroom\Wav2LipAvatarRenderer.cs" Link="Renderers\Wav2LipAvatarRenderer.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure-C# WebRTC + VP8 (no native FFmpeg). -->
    <ProjectReference Include="..\..\..\src\SIPSorcery\SIPSorcery.csproj" />
    <ProjectReference Include="..\..\..\src\SIPSorcery.VP8\SIPSorcery.VP8.csproj" />
    <!-- Optional native encoder (VIDEO_ENCODER=ffmpeg): only used when FFmpeg 8 shared
         libraries are present at runtime, e.g. the Linux container image. -->
    <ProjectReference Include="..\..\..\src\SIPSorceryMedia.FFmpeg\SIPSorceryMedia.FFmpeg.csproj" />
    <!-- Wires SIPSorcery's internal logging (ICE agent, DTLS, RTP) to the console - without
         this, SIPSorcery.LogFactory defaults to a null logger and ICE failures are invisible. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4"
                      Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- The shared avatar speech/AI pipeline (TTS/STT/LLM + the IAvatarMouth seam), the same
         library the WebRTCMaxHeadroom demo uses. sherpa-onnx + LLamaSharp come transitively. -->
    <ProjectReference Include="..\AvatarPipeline\AvatarPipeline.csproj" />
  </ItemGroup>
</Project>
