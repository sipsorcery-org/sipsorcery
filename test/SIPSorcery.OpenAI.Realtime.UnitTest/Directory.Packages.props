<Project>

  <!-- Enables Central Package Management for the OpenAI Realtime unit test project and pulls the
       shared test package versions. See test/Test.Packages.props and issue #1605. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <Import Project="../Test.Packages.props" />

</Project>
