<Project>
 <PropertyGroup Condition=" '$(Framework)' != 'NET461'">
   <LangVersion>8.0</LangVersion>
 </PropertyGroup>

  <PropertyGroup>
    <!-- Fallback for non-Windows/macOS build hosts (e.g. Linux CI). -->
    <SIPSorceryDesktopTargetFramework>net10.0</SIPSorceryDesktopTargetFramework>
    <SIPSorceryDesktopTargetFramework Condition="$([System.OperatingSystem]::IsWindows())">net10.0-windows10.0.17763.0</SIPSorceryDesktopTargetFramework>
    <SIPSorceryDesktopTargetFramework Condition="$([System.OperatingSystem]::IsMacOS())">net10.0-macos</SIPSorceryDesktopTargetFramework>
  </PropertyGroup>
</Project>
